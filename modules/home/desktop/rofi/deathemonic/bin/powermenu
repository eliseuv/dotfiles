#!/usr/bin/env bash
ddir="$HOME/.config/rofi/config"
uptime=$(uptime | sed -e 's/up //g')

# Match the icon-only layout selected in the main menu theme.
if [[ "${DIR:-}" == "powermenus" ]] || grep -q 'BUTTON = TRUE' "$ddir/powermenu.rasi"; then
    shutdown="󰐥"
    reboot="󰜉"
    lock="󰍁"
    suspend="󰒲"
    logout="󰍃 "
else
    shutdown="󰐥Shutdown"
    reboot="󰜉 Restart"
    lock="󰍁 Lock"
    suspend="󰒲Sleep"
    logout="󰍃 Logout"
fi

# Cancel is selected first. Only an explicit selection of the second row
# authorizes the action; Escape, closing the menu, and stray Enter cancel.
confirm() {
    local choice
    choice=$(printf '%s\n' '󰅖  Cancel' "$2" |
        rofi -dmenu -no-custom -format i -selected-row 0 -p "$1" \
            -theme "$ddir/power-confirm.rasi") || return 1
    [[ "$choice" == 1 ]]
}

choice=$(printf '%s\n' "$lock" "$suspend" "$logout" "$reboot" "$shutdown" |
    rofi -dmenu -no-custom -format i -selected-row 0 -p "UP - $uptime" \
        -theme "$ddir/powermenu.rasi") || exit 0

case "$choice" in
0) hyprlock ;;
1)
    if confirm 'Put this computer to sleep?' '󰒲  Sleep now'; then
        mpc -q pause
        wpctl set-mute @DEFAULT_SINK@ 1
        hyprlock
        systemctl suspend
    fi
    ;;
2) confirm 'Log out of this session?' '󰍃  Log out now' && uwsm stop ;;
3) confirm 'Restart this computer?' '󰜉  Restart now' && systemctl reboot ;;
4) confirm 'Shut down this computer?' '󰐥  Shut down now' && systemctl poweroff ;;
esac
