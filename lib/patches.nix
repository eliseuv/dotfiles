# Builds PATCHES.md from my.patches across every configuration, and the check
# that keeps it, the patch files and their in-place markers in agreement.
{
  lib,
  pkgs,
  nixosConfigurations,
  homeConfigurations,
}:
let
  root = ../.;
  patchDirs = [
    "modules/nixos/patches"
    "modules/home/patches"
  ];

  # Patch id -> repo-relative path of its module
  files = lib.listToAttrs (
    lib.concatMap (
      dir:
      let
        absolute = root + "/${dir}";
        names = lib.optionals (builtins.pathExists absolute) (
          lib.attrNames (lib.filterAttrs (_: type: type == "regular") (builtins.readDir absolute))
        );
      in
      map (name: {
        name = lib.removeSuffix ".nix" name;
        value = "${dir}/${name}";
      }) (lib.filter (lib.hasSuffix ".nix") names)
    ) patchDirs
  );

  configurations = nixosConfigurations // homeConfigurations;

  # Patch id -> { patch = metadata from the first configuration; activeOn = [ names ]; }
  patches = lib.foldlAttrs (
    acc: name: configuration:
    lib.foldlAttrs (
      acc': id: patch:
      acc'
      // {
        ${id} = {
          patch = acc'.${id}.patch or patch;
          activeOn = (acc'.${id}.activeOn or [ ]) ++ [ name ];
        };
      }
    ) acc configuration.config.my.patches
  ) { } configurations;

  ids = lib.sort lib.lessThan (lib.attrNames patches);

  errors =
    map (id: "${files.${id}}: no configuration sets my.patches.${id} (dead patch)") (
      lib.filter (id: !patches ? ${id}) (lib.attrNames files)
    )
    ++ map (id: "my.patches.${id}: no file named ${id}.nix under ${lib.concatStringsSep " or " patchDirs}") (
      lib.filter (id: !files ? ${id}) ids
    )
    ++ lib.concatMap (
      id:
      map (location: "${location}: missing PATCH(${id}) marker") (
        lib.filter (
          location:
          !(
            builtins.pathExists (root + "/${location}")
            && lib.hasInfix "PATCH(${id})" (builtins.readFile (root + "/${location}"))
          )
        ) patches.${id}.patch.locations
      )
    ) ids;

  link = path: "[`${path}`](${path})";

  renderPatch =
    id:
    let
      inherit (patches.${id}) patch activeOn;
    in
    ''
      ## ${id}

      ${patch.description}

      - **Module**: ${if files ? ${id} then link files.${id} else "(missing)"}
    ''
    + lib.optionalString (patch.locations != [ ]) ''
      - **Also changes**: ${lib.concatMapStringsSep ", " link patch.locations}
    ''
    + ''
      - **Upstream**: ${
        if patch.upstream == [ ] then "none known" else lib.concatStringsSep ", " patch.upstream
      }
      - **Remove when**: ${patch.removeWhen}
      - **Added**: ${patch.added}
      - **Status** (${patch.status.checked}): ${patch.status.note}
      - **Active on**: ${lib.concatStringsSep ", " (lib.sort lib.lessThan activeOn)}
    ''
    + lib.optionalString (patch.staleWhen == true) ''
      - **Stale check passes**: this patch is probably obsolete.
    '';

  index =
    ''
      # Patches

      <!-- Generated by `just patches` from my.patches (modules/shared/patches.nix). Do not edit. -->

      Temporary workarounds for upstream breakage, one module per patch under
      `modules/nixos/patches/` and `modules/home/patches/`.
    ''
    + (
      if ids == [ ] then
        "\nNo active patches.\n"
      else
        lib.concatMapStrings (id: "\n" + renderPatch id) ids
    );

  committed = root + "/PATCHES.md";
in
{

  index = pkgs.writeText "PATCHES.md" index;

  check =
    pkgs.runCommand "patches-index-check"
      {
        errors = lib.concatStringsSep "\n" errors;
        generated = pkgs.writeText "PATCHES.md" index;
        passAsFile = [ "errors" ];
      }
      ''
        status=0
        if [ -s "$errorsPath" ]; then
          cat "$errorsPath" >&2
          status=1
        fi
        ${
          if builtins.pathExists committed then
            ''
              if ! diff -u ${committed} "$generated" >&2; then
                echo "PATCHES.md is out of date: run \`just patches\`" >&2
                status=1
              fi
            ''
          else
            ''
              echo "PATCHES.md is missing: run \`just patches\`" >&2
              status=1
            ''
        }
        [ "$status" -eq 0 ] && touch "$out"
        exit "$status"
      '';

}
